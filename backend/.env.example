# FastAPI Server Binding
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional Local Ollama Server (for Zero-Shot / Few-Shot VLM runs on any OS/GPU)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_8B_MODEL=qwen3-vl:8b
# OLLAMA_BIN=/usr/bin/ollama

# Optional FFmpeg binary override (defaults to `ffmpeg` on PATH)
# FFMPEG_BIN=/usr/bin/ffmpeg

# Optional storage / weights / adapter directories (default to relative paths under backend/)
# STORAGE_DIR=./storage
# ADAPTERS_DIR=./adapters
# AUTO_WEIGHTS_DIR=./auto_annotate/weights

# PyTorch / Florence-2 precision (`float16` on CUDA/MPS or `float32` if needed)
FLORENCE_DTYPE=float16
FLORENCE2_LARGE_MODEL_PATH=florence-community/Florence-2-large-ft
FLORENCE2_BASE_MODEL_PATH=florence-community/Florence-2-base-ft

# Apple Silicon MLX-only Hugging Face repos
MLX_8BIT_MODEL_PATH=mlx-community/Qwen3-VL-4B-Instruct-8bit
MLX_4BIT_MODEL_PATH=mlx-community/Qwen3-VL-4B-Instruct-4bit
